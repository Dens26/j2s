{% extends 'base.html.twig' %}

{% block title %}J2S-Accueil
{% endblock %}

{% block body %}
	<div class="home-container">
		<div class="m-2">
			<!-- Titre principal -->
			<h1 class="title m-3">Relevez le défi !</h1>
			<p class="fs-2 text-center">Découvrez si vous pouvez trouver le jeu de société du moment</p>

			<!-- Appel à l'action -->
			<div class="d-flex gap-2 mx-2">
				<a href="{{path('app_find_the_game')}}" class="btn btn-go d-flex w-50 justify-content-center align-items-center">Trouve le jeu mystère!</a>
				<a href="{{path('app_oldchallenges')}}" class="btn btn-go d-flex w-50  justify-content-center align-items-center">Les défis passés !</a>
			</div>

			<!-- Étapes du jeu -->
			<div class="component mx-2 mt-4">
				<h3 class="fw-bold text-center fs-1 mb-4">Comment jouer ?</h3>
				<p class="step">
					<strong>🎲 1 :</strong>
					Choisis l'option "Jeu mystère" ou "Défis passés"
				</p>
				<p class="step">
					<strong>🔎 2 :</strong>
					Entre le nom d'un jeu dans la barre de recherche.
				</p>
				<p class="step">
					<strong>🎮 3 :</strong>
					Compare les indices affichés avec le jeu secret.
				</p>
				<p class="step">
					<strong>🧩 4 :</strong>
					Essaie plusieurs jeux et analysez les points communs.
				</p>
				<p class="step">
					<strong>🏆 5 :</strong>
					Félicitations ! A bientôt pour un nouveau défi.
				</p>
			</div>
		</div>

		<!-- Section FAQ -->
		{# <div class="mt-5 text-start component">
					<h3 class="fw-bold">Questions Fréquentes</h3>
		
					<p>
						<strong>❓ Comment démarrer ?</strong><br>
						Cliquez sur le bouton ci-dessus et essayez de deviner le jeu mystère en entrant un nom de jeu.</p>
		
					<p>
						<strong>❓ Que faire si je n'y arrive pas ?</strong><br>
						Pas de souci ! Chaque tentative vous donnera des indices pour affiner votre recherche.</p>
		
					<p>
						<strong>❓ Puis-je jouer sur mon smartphone ?</strong><br>
						Oui, le jeu est accessible sur tous les appareils : ordinateur, tablette et mobile.</p>
		
					<p>
						<strong>❓ Le jeu est-il payant ?</strong><br>
						Non, ce jeu est entièrement gratuit et conçu pour le plaisir de tous.</p>
		
					<p>
						<strong>❓ Comment obtenir de l'aide ?</strong><br>
						Besoin d'assistance ? Contactez-nous à
						<a href="mailto:support@j2s.com">support@j2s.com</a>.</p>
				</div> #}
	</div>

{% endblock %}
